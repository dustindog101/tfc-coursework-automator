# Copy to .env and fill in your credentials (never commit .env)
TFC_EMAIL=your-email@example.com
TFC_PASSWORD=your-password

# iDriveSafely driving safety course (app.idrivesafely.com)
IDRIVE_EMAIL=your-email@example.com
IDRIVE_PASSWORD=your-password

# Optional overrides
# TFC_BASE_URL=https://www.thefoundationofchange.org
# TFC_DAILY_HOUR_LIMIT=8.0
# TFC_MIN_HOURS_LEFT=0.35
# TFC_LOG_FILE=./automation.log
# TFC_EVENTS_FILE=./events.jsonl
# OPENCODE_MODEL=opencode/deepseek-v4-flash-free,opencode/mimo-v2.5-free
# OPENCODE_VARIANT=minimal
# AGY_QUOTA_COOLDOWN_S=7200
# TFC_REFLECTION_DRAFTS_FILE=./reflection_drafts.json
# PLAYWRIGHT_BROWSERS_PATH=~/Library/Caches/ms-playwright

# Telegram (optional) — revoke token if exposed; never commit real token
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ENABLED=1
# TELEGRAM_LESSON_EDIT_INTERVAL_S=60
